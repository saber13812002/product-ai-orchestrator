# ===========================================================================
# AI Product Orchestrator — environment template
#
#   cp .env.example .env
#   # then fill in the real values below and start:
#   #   Mode A (external gateway):   docker compose up -d
#   #   Mode B (bundled sidecar):    docker compose --profile bundled-litellm up -d
#
# Do NOT commit your filled-in .env (it is gitignored). This file has no secrets.
#
# LiteLLM deployment modes (STEP 9) — full guide in docs/LITELLM.md:
#   external (default) : you already have a LiteLLM gateway; set the gateway
#                        block only (section 1).
#   bundled            : this repo starts its own LiteLLM sidecar; set the
#                        sidecar block (section 2) — no external gateway needed.
# ===========================================================================

# --- 0. Mode (optional — `external` is the default) ------------------------
# external = use your own LiteLLM gateway (section 1).
# bundled  = start the bundled sidecar (section 2); AgentOS auto-connects to
#            http://litellm:4000/v1 over the compose network.
LITELLM_MODE=external

# --- 1. External LiteLLM gateway (REQUIRED for Mode A) ----------------------
# Base URL of your LiteLLM proxy, e.g. http://172.20.1.52:4000/v1
LITELLM_BASE_URL=
# The LiteLLM master / virtual key.
LITELLM_API_KEY=

# --- 2. Bundled LiteLLM sidecar (REQUIRED for Mode B, unused in Mode A) -----
# Master key for the sidecar gateway. Generate one:  echo "sk-$(openssl rand -hex 32)"
# AgentOS authenticates to the sidecar with this same value automatically.
LITELLM_MASTER_KEY=
# Host port for human access to the sidecar's API + UI (loopback only).
# Defaults to 4100 so it never collides with an external gateway on 4000.
#LITELLM_PORT=4100
# Optional: rename the sidecar container if the name is taken on this host.
#LITELLM_CONTAINER_NAME=litellm-sidecar

# Backend servers the sidecar routes to. Any OpenAI-compatible endpoint works:
# vLLM, SGLang, TGI, or the real OpenAI/Anthropic-style APIs. The sidecar exposes
# each under the SAME name AgentOS sends (the AGENT_MODEL_* vars, section 3), so
# one set of names drives both containers.
#   _API_BASE   = the backend's /v1 URL.
#   _API_KEY    = the backend's key (leave empty for local no-auth servers).
#   _API_MODEL  = the model ID that backend actually SERVES. Leave empty to reuse
#                 the AGENT_MODEL_* name (normal case: OpenAI, or a vLLM you named
#                 cleanly). Set it only when the backend serves a different/ugly
#                 ID (e.g. a raw Qwen vLLM that serves "/models/Qwen3.8-27B-FP8").
#
# Example A — an OpenAI-style API where the model names match:
#   FAST_MODEL_API_BASE=https://api.openai.com/v1
#   FAST_MODEL_API_KEY=sk-...        # (never commit a real key)
# Example B — a raw Qwen vLLM fleet (model ID differs from the AgentOS name):
#   FAST_MODEL_API_BASE=http://172.20.1.53:8000/v1
#   FAST_MODEL_API_MODEL=/models/Qwen3.8-27B-FP8
#   DEEP_MODEL_API_BASE=http://172.20.1.53:8000/v1
#   DEEP_MODEL_API_MODEL=/models/Qwen3.8-27B-FP8
#   ALT_MODEL_API_BASE=http://172.20.1.53:8001/v1
#   ALT_MODEL_API_MODEL=/models/Qwen3.8-27B-FP8
#   NOTE (example B): these backends are THINKING models. For the structured
#   `fast` role, uncomment the enable_thinking snippet in litellm/config.yaml so
#   it returns complete JSON instead of burning its budget on reasoning.
FAST_MODEL_API_BASE=
FAST_MODEL_API_KEY=
FAST_MODEL_API_MODEL=
DEEP_MODEL_API_BASE=
DEEP_MODEL_API_KEY=
DEEP_MODEL_API_MODEL=
ALT_MODEL_API_BASE=
ALT_MODEL_API_KEY=
ALT_MODEL_API_MODEL=

# --- 3. Model IDs (as served by your gateway / backends) --------------------
# Logical roles the pipeline routes to. Defaults are the reference Qwen fleet;
# set these to whatever model names your gateway (Mode A) or backends (Mode B)
# actually serve.
AGENT_MODEL_FAST=qwen38-nothinking
AGENT_MODEL_DEEP=qwen38
AGENT_MODEL_ALT=qwen38-sglang
# Optional deterministic stub used only to prove routing (leave as-is unless
# your gateway serves a different mock model name).
AGENT_MODEL_STUB=mock-agent-v1
# NOTE (bundled mode): these AGENT_MODEL_* values are the SAME names the bundled
# sidecar exposes (litellm/config.yaml sets model_name: ${FAST_MODEL} etc., which
# compose maps back to AGENT_MODEL_*). So changing a value here repoints both
# AgentOS and the sidecar's alias automatically — no other edit needed.

# --- 4. Storage (optional) ---------------------------------------------------
# The pipeline's SQLite/SQLite-free state. Left to the runtime default (/data)
# unless you need to override it inside the container.
DATABASE_URL=

# --- 5. HTTP (optional) ------------------------------------------------------
# Host port the AgentOS HTTP API is published on.
PORT=7777
# Optional: rename the AgentOS container if the name is taken on this host.
#CONTAINER_NAME=agno-agentos

# --- Legacy aliases (optional) -----------------------------------------------
# If your deployment predates this template and only sets OPENAI_* vars, they
# are still honored as a fallback in external mode. Setting LITELLM_* above is
# preferred.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
