# ===========================================================================
# AI Product Orchestrator — environment template
#
#   cp .env.example .env
#   # then fill in the real values below and start:  docker compose up -d
#
# Do NOT commit your filled-in .env (it is gitignored). This file has no secrets.
# ===========================================================================

# --- LiteLLM gateway (REQUIRED — external, not run by this repo) ------------
# Base URL of your LiteLLM proxy, e.g. http://172.20.1.52:4000/v1  or  http://litellm:4000/v1
LITELLM_BASE_URL=
# The LiteLLM master / virtual key.
LITELLM_API_KEY=

# --- Model IDs (as served by LiteLLM) ---------------------------------------
# Logical roles the pipeline routes to. Defaults are the reference Qwen fleet;
# set these to whatever model names your gateway actually serves.
AGENT_MODEL_FAST=
AGENT_MODEL_DEEP=
AGENT_MODEL_ALT=
# Optional deterministic stub used only to prove routing (leave as-is unless
# your gateway serves a different mock model name).
AGENT_MODEL_STUB=mock-agent-v1

# --- Storage (optional) ------------------------------------------------------
# The pipeline's SQLite/SQLite-free state. Left to the runtime default (/data)
# unless you need to override it inside the container.
DATABASE_URL=

# --- HTTP (optional) ---------------------------------------------------------
# Host port the AgentOS HTTP API is published on.
PORT=7777

# --- Legacy aliases (optional) -----------------------------------------------
# If your deployment predates this template and only sets OPENAI_* vars, they
# are still honored as a fallback. Setting LITELLM_* above is preferred.
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
